{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebMCP Console",
  "version": "1.0.24",
  "identifier": "com.webmcp.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebMCP Console",
        "width": 1540,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "../../docs/assets/webmcp-logo-light.png"
    ]
  }
}
