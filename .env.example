HOST=127.0.0.1
PORT=7676
# Owner password generated by `gptmcp init` in ~/.gptmcp/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# GPTMCP_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# GPTMCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# GPTMCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# GPTMCP_OAUTH_SCOPES=gptmcp
# GPTMCP_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
GPTMCP_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# For temporary tunnels, prefer setting this per run. GPTMCP derives the
# inbound Host allowlist from this URL.
# GPTMCP_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# GPTMCP_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
GPTMCP_TOOL_MODE=full
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
GPTMCP_WIDGETS=changes
GPTMCP_LOG_LEVEL=info
GPTMCP_LOG_FORMAT=json
GPTMCP_LOG_REQUESTS=1
GPTMCP_LOG_ASSETS=0
GPTMCP_LOG_TOOL_CALLS=1
GPTMCP_LOG_SHELL_COMMANDS=0
# GPTMCP_TRUST_PROXY=1
# GPTMCP_STATE_DIR=/home/waishnav/.local/share/gptmcp
# GPTMCP_WORKTREE_ROOT=/home/waishnav/.gptmcp/worktrees
# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# GPTMCP_ARTIFACTS=1
# GPTMCP_ARTIFACT_MAX_FILE_BYTES=104857600
# GPTMCP_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set GPTMCP_SKILLS=0 to hide them.
# GPTMCP_SKILLS=0
# GPTMCP_AGENT_DIR=/home/waishnav/.codex
# GPTMCP_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills
