HOST=127.0.0.1
PORT=7676
# Owner password generated by `webmcp init` in ~/.webmcp/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# WebMCP_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# WebMCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# WebMCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# WebMCP_OAUTH_SCOPES=webmcp
# WebMCP_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
WebMCP_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# For temporary tunnels, prefer setting this per run. WebMCP derives the
# inbound Host allowlist from this URL.
# WebMCP_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# WebMCP_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
WebMCP_TOOL_MODE=full
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
WebMCP_WIDGETS=changes
WebMCP_LOG_LEVEL=info
WebMCP_LOG_FORMAT=json
WebMCP_LOG_REQUESTS=1
WebMCP_LOG_ASSETS=0
WebMCP_LOG_TOOL_CALLS=1
WebMCP_LOG_SHELL_COMMANDS=0
# WebMCP_TRUST_PROXY=1
# WebMCP_STATE_DIR=/home/waishnav/.local/share/webmcp
# WebMCP_WORKTREE_ROOT=/home/waishnav/.webmcp/worktrees
# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# WebMCP_ARTIFACTS=1
# WebMCP_ARTIFACT_MAX_FILE_BYTES=104857600
# WebMCP_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set WebMCP_SKILLS=0 to hide them.
# WebMCP_SKILLS=0
# WebMCP_AGENT_DIR=/home/waishnav/.codex
# WebMCP_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills
